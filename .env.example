# Secret key from https://dashboard.stripe.com/apikeys
# Use the test key (sk_test_...) until a real charge should go through.
# Never put this key in client code or commit the real .env file.
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe CLI / dashboard endpoint secret for /api/stripe/webhook
# Events: checkout.session.completed, charge.refunded,
# charge.dispute.created, charge.dispute.updated, charge.dispute.closed,
# review.opened, review.closed
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Password for /admin. At least 8 characters.
ADMIN_PASSWORD=replace_me_please

# Shippo token from https://apps.goshippo.com/settings/api
# Labels are bought when an order is marked prepared, same purchase flow as Elison.
SHIPPO_API_TOKEN=shippo_test_replace_me
# Required in production. The tracking webhook URL must include ?token=this value.
SHIPPO_WEBHOOK_SECRET=

# Hosted order database. Local dev uses data/orders.sqlite until these are set.
# Create a database at https://turso.tech and paste both values into Vercel as well.
TURSO_DATABASE_URL=libsql://replace-me.turso.io
TURSO_AUTH_TOKEN=replace_me
